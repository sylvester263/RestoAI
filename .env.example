# Environment variables — copy to .env and fill in values

# ── Server ──
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_ai

# Comma-separated list of allowed frontend origins (no wildcard)
CORS_ORIGINS=http://localhost:3000,https://your-deployed-frontend.example.com

# ── JWT ──
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
# Fallback number for tenants that haven't connected their own via Embedded
# Signup (impl-30) yet — e.g. demo mode / single-tenant deployments.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── WhatsApp Embedded Signup (impl-30) — Meta Tech Provider app identity ──
# Requires an approved, Live Meta Tech Provider app (business/compliance
# precondition, not something these vars alone unlock). appId/configId are
# sent to the browser by the /api/whatsapp-connect/session endpoint — not
# secrets in the appSecret sense, but still only ever meaningful once the
# app is actually Live.
META_APP_ID=your-meta-tech-provider-app-id
META_APP_SECRET=your-meta-tech-provider-app-secret
META_CONFIG_ID=your-embedded-signup-configuration-id

# ── Encryption at rest (impl-30's WhatsApp two-step verification PIN, and
# any future value needing this) — 32 random bytes, hex-encoded.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-32-random-bytes-hex-encoded

# ── Qwen / Alibaba Cloud DashScope ──
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen-plus

# ── Supabase (optional — for realtime) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ── Web Push (VAPID) — generate with `npx web-push generate-vapid-keys` ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Agentic AI systems (impl-14..21) ──
# Shared secret required in the X-Cron-Secret header on /api/agents/*/run
CRON_SECRET=change-me-to-a-random-secret

# ── App URL (used for staff invite links, absolute URLs in messages) ──
APP_URL=https://your-deployed-frontend.example.com

# ── Rider JWT expiry (optional — defaults to 16h) ──
# RIDER_JWT_EXPIRES_IN=16h

# ── Super Admin Panel (impl-29) — dedicated JWT secret, never derived from JWT_SECRET ──
SUPER_ADMIN_JWT_SECRET=change-me-to-a-strong-dedicated-secret
# SUPER_ADMIN_SESSION_EXPIRES_IN=6h

# First super admin seed (used only by: node src/scripts/seed-super-admin.js)
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=change-me-min-12-chars
