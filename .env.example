# Environment variables — copy to .env and fill in values

# ── Server ──
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_ai

# Comma-separated list of allowed frontend origins (no wildcard)
CORS_ORIGINS=http://localhost:3000,https://your-deployed-frontend.example.com

# ── JWT ──
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── Qwen / Alibaba Cloud DashScope ──
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen-plus

# ── Supabase (optional — for realtime) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ── Web Push (VAPID) — generate with `npx web-push generate-vapid-keys` ──
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Agentic AI systems (impl-14..21) ──
# Shared secret required in the X-Cron-Secret header on /api/agents/*/run
CRON_SECRET=change-me-to-a-random-secret

# ── App URL (used for staff invite links, absolute URLs in messages) ──
APP_URL=https://your-deployed-frontend.example.com

# ── Rider JWT expiry (optional — defaults to 16h) ──
# RIDER_JWT_EXPIRES_IN=16h
